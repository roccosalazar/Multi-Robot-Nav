FROM --platform=linux/arm64 ros:humble-perception

USER root

RUN if [ -f /etc/apt/sources.list ]; then \
        sed -i 's|http://archive.ubuntu.com/ubuntu/|http://it.archive.ubuntu.com/ubuntu/|g' /etc/apt/sources.list && \
        sed -i 's|http://security.ubuntu.com/ubuntu/|http://it.archive.ubuntu.com/ubuntu/|g' /etc/apt/sources.list; \
    fi && \
    find /etc/apt/sources.list.d -type f \( -name '*.list' -o -name '*.sources' \) -exec sed -i 's|http://archive.ubuntu.com/ubuntu/|http://it.archive.ubuntu.com/ubuntu/|g' {} \; && \
    find /etc/apt/sources.list.d -type f \( -name '*.list' -o -name '*.sources' \) -exec sed -i 's|http://security.ubuntu.com/ubuntu/|http://it.archive.ubuntu.com/ubuntu/|g' {} \;

ARG USERNAME=ubuntu
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN if ! id -u $USER_UID >/dev/null 2>&1; then \
        groupadd --gid $USER_GID $USERNAME && \
        useradd -s /bin/bash --uid $USER_UID --gid $USER_GID -m $USERNAME; \
    fi

RUN apt-get update && \
    apt-get install -y sudo && \
    echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME && \
    chmod 0440 /etc/sudoers.d/$USERNAME && \
    rm -rf /var/lib/apt/lists/*

USER $USERNAME

RUN sudo usermod --append --groups video $USERNAME

RUN sudo apt-get update && \
    sudo apt-get upgrade -y && \
    sudo apt-get install -y git && \
    sudo rm -rf /var/lib/apt/lists/*

RUN rosdep update

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc

RUN sudo apt-get update && sudo apt-get install -y \
    wget \
    curl \
    gnupg2 \
    ripgrep \
    lsb-release \
    python3-vcstool \
    python3-rosdep \
    software-properties-common \
    build-essential \
    cmake \
    python3-pip \
    python3-colcon-common-extensions \
    python3-progressbar \
    mesa-utils \
    grep \
    coreutils \
    procps \
    gpg \
    ca-certificates \
    x11-apps \
    && sudo rm -rf /var/lib/apt/lists/*

RUN sudo mkdir -p /usr/share/keyrings && \
    curl -sSL http://packages.osrfoundation.org/gazebo.key | sudo gpg --dearmor -o /usr/share/keyrings/gazebo-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/gazebo-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" | sudo tee /etc/apt/sources.list.d/gazebo-stable.list > /dev/null && \
    sudo apt-get update && \
    sudo apt-get install -y ignition-fortress && \
    sudo rm -rf /var/lib/apt/lists/*

RUN sudo apt-get update && sudo apt-get install -y \
    ros-humble-moveit-setup-srdf-plugins \
    ros-humble-franka-description \
    ros-humble-kortex-description \
    ros-humble-robotiq-description \
    ros-humble-ur-description \
    ros-humble-ewellix-description \
    ros-humble-clearpath-viz \
    ros-humble-ign-ros2-control \
    ros-humble-ros-gz \
    ros-humble-ros2controlcli \
    ros-humble-moveit-planners-chomp \
    ros-humble-gripper-controllers \
    ros-humble-moveit-configs-utils \
    ros-humble-moveit-kinematics \
    ros-humble-moveit-planners \
    ros-humble-moveit-ros-move-group \
    ros-humble-moveit-ros-warehouse \
    ros-humble-moveit-simple-controller-manager \
    ros-humble-position-controllers \
    ros-humble-clearpath-mecanum-drive-controller \
    ros-humble-controller-manager \
    ros-humble-diff-drive-controller \
    ros-humble-imu-filter-madgwick \
    ros-humble-interactive-marker-twist-server \
    ros-humble-joint-state-broadcaster \
    ros-humble-joint-trajectory-controller \
    ros-humble-joy-linux \
    ros-humble-robot-localization \
    ros-humble-twist-mux \
    ros-humble-microstrain-inertial-description \
    ros-humble-realsense2-description \
    ros-humble-velodyne-description \
    ros-humble-rviz2 \
    ros-humble-tf2-tools \
    ros-humble-tf2-ros \
    && sudo rm -rf /var/lib/apt/lists/*

RUN sudo apt-get update && sudo apt-get install -y \
    ros-humble-geodesy \
    ros-humble-nmea-msgs \
    ros-humble-geographic-msgs \
    ros-humble-libg2o \
    libgeographic-dev \
    libomp-dev \
    libeigen3-dev \
    libsuitesparse-dev \
    libspdlog-dev \
    libceres-dev \
    qtdeclarative5-dev \
    qt5-qmake \
    libqglviewer-dev-qt5 \
    && sudo rm -rf /var/lib/apt/lists/*

RUN cd /tmp && \
    git clone https://github.com/Livox-SDK/Livox-SDK2.git && \
    cd Livox-SDK2 && \
    mkdir -p build && \
    cd build && \
    cmake .. && \
    make -j2 && \
    sudo make install && \
    sudo ldconfig && \
    cd / && \
    sudo rm -rf /tmp/Livox-SDK2

RUN wget -q -O- https://packagecloud.io/dcommander/virtualgl/gpgkey | \
    gpg --dearmor | sudo tee /etc/apt/trusted.gpg.d/VirtualGL.gpg >/dev/null && \
    wget -q -O- https://raw.githubusercontent.com/VirtualGL/repo/main/VirtualGL.list | \
    sudo tee /etc/apt/sources.list.d/VirtualGL.list >/dev/null && \
    sudo apt-get update && \
    sudo apt-get install -y virtualgl && \
    sudo rm -rf /var/lib/apt/lists/*

RUN sudo apt-get update && sudo apt-get install -y \
    ros-humble-clearpath-desktop \
    ros-humble-clearpath-config-live \
    && sudo rm -rf /var/lib/apt/lists/*

RUN sudo apt-get update && sudo apt-get install -y \
    ros-humble-desktop-full \
    ros-humble-simulation \
    ros-humble-depthimage-to-laserscan \
    ros-humble-image-tools \
    ros-humble-ros-ign-bridge \
    ros-humble-ros-ign-gazebo \
    ros-humble-ros-ign-gazebo-demos \
    ros-humble-ros-ign-image \
    ros-humble-ros-ign-interfaces \
    ros-humble-rqt-common-plugins \
    ros-humble-rttest \
    ros-humble-tlsf \
    ros-humble-tlsf-cpp \
    libunwind-dev \
    mailcap \
    mime-support \
    python3-cairo \
    python3-pydot \
    && sudo rm -rf /var/lib/apt/lists/*

RUN sudo python3 -m pip install --upgrade pip wheel && \
    sudo apt-get update && \
    sudo apt-get install -y --reinstall python3-setuptools && \
    sudo rm -rf \
        /usr/local/lib/python3.10/dist-packages/setuptools \
        /usr/local/lib/python3.10/dist-packages/setuptools-*.dist-info \
        /usr/local/lib/python3.10/dist-packages/_distutils_hack && \
    sudo rm -rf /var/lib/apt/lists/*

# Keep NumPy 1.x for Ubuntu Matplotlib 3.5.x and ROS Humble Python packages.
RUN printf 'numpy==1.26.4\nsetuptools<80\n' | sudo tee /etc/pip-constraints.txt > /dev/null && \
    printf '[global]\nconstraint = /etc/pip-constraints.txt\n' | sudo tee /etc/pip.conf > /dev/null

ENV PIP_CONSTRAINT=/etc/pip-constraints.txt

RUN sudo rm -rf \
        /usr/local/lib/python3.10/dist-packages/numpy \
        /usr/local/lib/python3.10/dist-packages/numpy-*.dist-info \
        /usr/local/lib/python3.10/dist-packages/numpy.libs

RUN sudo python3 -m pip install --no-cache-dir --upgrade \
    "networkx>=2.8.8" \
    numba \
    "numpy==1.26.4" \
    Pillow \
    scikit-learn \
    scipy \
    sortedcontainers \
    distinctipy \
    numpy-quaternion

RUN sudo apt-get update && sudo apt-get install -y \
    libeigen3-dev \
    libboost-all-dev \
    python3-dev \
    pybind11-dev \
    && sudo rm -rf /var/lib/apt/lists/*

RUN cd /tmp && \
    git clone --recursive https://github.com/MIT-SPARK/TEASER-plusplus.git && \
    cd TEASER-plusplus && \
    git submodule update --init --recursive && \
    sudo python3 -m pip install --no-cache-dir . && \
    sudo ldconfig && \
    cd / && \
    sudo rm -rf /tmp/TEASER-plusplus

RUN sudo apt-get update && sudo apt-get install -y \
    libboost-all-dev \
    python3-dev \
    python3-pip \
    && sudo rm -rf /var/lib/apt/lists/*

RUN cd /tmp && \
    git clone https://github.com/borglab/gtsam.git && \
    cd gtsam && \
    git checkout 4.1.1 && \
    mkdir build && \
    cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DGTSAM_BUILD_PYTHON=OFF \
        -DGTSAM_WITH_TBB=OFF && \
    cmake --build . -j2 && \
    sudo cmake --install . && \
    sudo ldconfig && \
    cd / && \
    sudo rm -rf /tmp/gtsam

RUN sudo apt-get update && sudo apt-get install -y \
    libpcl-dev \
    ros-humble-nav2-common \
    ros-humble-nav2-msgs \
    python3-pytest \
    ros-humble-rtabmap \
    ros-humble-rtabmap-conversions \
    ros-humble-rtabmap-msgs \
    && sudo rm -rf /var/lib/apt/lists/*

RUN sudo python3 -m pip install --no-cache-dir --upgrade \
    "torch>=1.13.0" \
    "torchvision>=0.14.0"

RUN sudo apt-get update && sudo apt-get install -y \
    ros-humble-teleop-twist-keyboard \
    && sudo rm -rf /var/lib/apt/lists/*

RUN sudo python3 -m pip install --no-cache-dir --upgrade \
    "pandas==2.3.3" \
    "open3d==0.18.0"

RUN sudo python3 -m pip install --no-cache-dir --upgrade \
    "addict==2.4.0" \
    "pyquaternion==0.9.9" \
    "tqdm==4.67.3"

RUN python3 -c 'from pathlib import Path; import site; import matplotlib, numpy, pandas, scipy; from numpy.core.umath import ERR_IGNORE; infos = [dist for site_dir in site.getsitepackages() for dist in Path(site_dir).glob("numpy-*.dist-info") if str(Path(site_dir)).startswith("/usr/local/")]; assert len(infos) == 1, "Expected one pip NumPy dist-info in /usr/local, found: " + ", ".join(str(path) for path in infos); assert numpy.__version__ == "1.26.4", f"Expected NumPy 1.26.4, imported {numpy.__version__}"; print("NumPy", numpy.__version__, numpy.__file__, "ERR_IGNORE", ERR_IGNORE); print("Matplotlib", matplotlib.__version__, matplotlib.__file__); print("Pandas", pandas.__version__, pandas.__file__); print("SciPy", scipy.__version__, scipy.__file__)'
